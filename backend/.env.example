PORT=5000
NODE_ENV=development
DISABLE_BACKGROUND_SCHEDULERS=true

# Use a separately provisioned development database, never auron_collect_app.
DATABASE_URL="postgresql://postgres:replace_me@localhost:5432/auron_collect_app_dev?schema=public"

# Development customer email remains disabled unless one of the explicit,
# purpose-limited manual-send or reminder-scheduler opt-ins is enabled.
ENABLE_DEV_EMAIL_DELIVERY=false

# Automatic reminder scheduling remains disabled in development unless this
# separate opt-in is enabled. It starts only the email reminder scheduler,
# leaves overdue reminders pending for explicit review, and requires SMTP.
ENABLE_DEV_REMINDER_SCHEDULER=false

# Gmail SMTP uses a Google App Password (not the normal account password).
# Keep SMTP_PASS in an ignored local env file or a deployment secret store.
# Development loads only missing SMTP keys from .env; DATABASE_URL is untouched.
JWT_SECRET=replace_with_a_long_random_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

SMS_ENABLED=false
SMS_PROVIDER=mock
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
