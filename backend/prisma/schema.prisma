generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id                                String                             @id @default(uuid())
  name                              String
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  adminNotificationReads            AdminNotificationRead[]
  auditLogs                         AuditLog[]
  billingInvoices                   BillingInvoice[]
  billingPayments                   BillingPayment[]
  billingPaymentReceipts            BillingPaymentReceipt[]
  communications                    Communication[]
  creditAdjustments                 CreditAdjustment[]
  customers                         Customer[]
  customerAssistantMessages         CustomerAssistantMessage[]
  customerNotifications             CustomerNotification[]
  customerSubscriptions             CustomerSubscription[]
  customerSubscriptionInvoices      CustomerSubscriptionInvoice[]
  customerSubscriptionPayments      CustomerSubscriptionPayment[]
  customerSubscriptionPlans         CustomerSubscriptionPlan[]
  customerSubscriptionReceipts      CustomerSubscriptionReceipt[]
  customerSubscriptionWebhookEvents CustomerSubscriptionWebhookEvent[]
  disputes                          Dispute[]
  invoices                          Invoice[]
  promises                          PromiseToPay[]
  razorpayWebhookEvents             RazorpayWebhookEvent[]
  receipts                          Receipt[]
  paymentAllocations                ReceiptAllocation[]
  reminders                         Reminder[]
  reminderTemplates                 ReminderTemplate[]
  subscriptions                     Subscription[]
  tasks                             Task[]
  taskHistories                     TaskHistory[]
  users                             User[]
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String
  password               String
  role                   String                  @default("USER")
  organisationId         String
  createdAt              DateTime                @default(now())
  sessionVersion         Int                     @default(0)
  adminNotificationReads AdminNotificationRead[]
  organisation           Organisation            @relation(fields: [organisationId], references: [id])

  @@unique([email, organisationId])
}

model Customer {
  id                        String                             @id @default(uuid())
  customerCode              String?
  name                      String
  type                      String                             @default("BUSINESS")
  contactPerson             String?
  email                     String?
  phone                     String?
  billingAddress            String?
  shippingAddress           String?
  taxRegistration           String?
  paymentTerms              String?
  creditLimit               Decimal?                           @db.Decimal(14, 2)
  status                    String                             @default("ACTIVE")
  notes                     String?
  organisationId            String
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  riskLevel                 String                             @default("LOW")
  communications            Communication[]
  organisation              Organisation                       @relation(fields: [organisationId], references: [id])
  assistantMessages         CustomerAssistantMessage[]
  notifications             CustomerNotification[]
  portalAccount             CustomerPortalAccount?
  subscriptions             CustomerSubscription[]
  subscriptionInvoices      CustomerSubscriptionInvoice[]
  subscriptionPayments      CustomerSubscriptionPayment[]
  billingPayments            BillingPayment[]
  subscriptionReceipts      CustomerSubscriptionReceipt[]
  subscriptionWebhookEvents CustomerSubscriptionWebhookEvent[]
  disputes                  Dispute[]
  emailDeliveryAttempts     EmailDeliveryAttempt[]
  invoices                  Invoice[]
  promises                  PromiseToPay[]
  receipts                  Receipt[]
  reminders                 Reminder[]
  tasks                     Task[]

  @@unique([customerCode, organisationId])
  @@index([organisationId])
  @@index([name])
  @@index([email])
  @@index([riskLevel])
}

model Invoice {
  id                    String                 @id @default(uuid())
  invoiceNumber         String
  invoiceDate           DateTime
  dueDate               DateTime
  currency              String                 @default("INR")
  subtotal              Decimal                @db.Decimal(14, 2)
  tax                   Decimal                @default(0) @db.Decimal(14, 2)
  discount              Decimal                @default(0) @db.Decimal(14, 2)
  total                 Decimal                @db.Decimal(14, 2)
  assignedExecutive     String?
  salesperson           String?
  status                String                 @default("DRAFT")
  documentUrl           String?
  notes                 String?
  customerId            String
  organisationId        String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  communications        Communication[]
  creditAdjustments     CreditAdjustment[]
  customerNotifications CustomerNotification[]
  disputes              Dispute[]
  emailDeliveryAttempts EmailDeliveryAttempt[]
  customer              Customer               @relation(fields: [customerId], references: [id])
  organisation          Organisation           @relation(fields: [organisationId], references: [id])
  promises              PromiseToPay[]
  allocations           ReceiptAllocation[]
  reminders             Reminder[]
  tasks                 Task[]

  @@unique([invoiceNumber, organisationId])
  @@index([organisationId])
  @@index([customerId])
  @@index([dueDate])
}

model Receipt {
  id                    String                 @id @default(uuid())
  receiptNumber         String
  receiptDate           DateTime
  amount                Decimal                @db.Decimal(14, 2)
  currency              String                 @default("INR")
  paymentMethod         String
  transactionReference  String?
  notes                 String?
  documentUrl           String?
  status                String                 @default("POSTED")
  customerId            String
  organisationId        String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customerNotifications CustomerNotification[]
  emailDeliveryAttempts EmailDeliveryAttempt[]
  customer              Customer               @relation(fields: [customerId], references: [id])
  organisation          Organisation           @relation(fields: [organisationId], references: [id])
  allocations           ReceiptAllocation[]

  @@unique([receiptNumber, organisationId])
  @@index([organisationId])
  @@index([customerId])
  @@index([receiptDate])
}

model ReceiptAllocation {
  id             String       @id @default(uuid())
  amount         Decimal      @db.Decimal(14, 2)
  receiptId      String
  invoiceId      String
  organisationId String
  status         String       @default("POSTED")
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  receipt        Receipt      @relation(fields: [receiptId], references: [id])

  @@index([organisationId])
  @@index([receiptId])
  @@index([invoiceId])
}

model Task {
  id                String         @id @default(uuid())
  title             String
  description       String?
  taskType          String         @default("CALL")
  priority          String         @default("MEDIUM")
  status            String         @default("PENDING")
  dueDate           DateTime
  assignedExecutive String?
  outcome           String?
  notes             String?
  nextAction        String?
  organisationId    String
  customerId        String
  invoiceId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  promises          PromiseToPay[]
  customer          Customer       @relation(fields: [customerId], references: [id])
  invoice           Invoice?       @relation(fields: [invoiceId], references: [id])
  organisation      Organisation   @relation(fields: [organisationId], references: [id])
  histories         TaskHistory[]

  @@index([organisationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([dueDate])
  @@index([status])
}

model TaskHistory {
  id             String       @id @default(uuid())
  outcome        String
  notes          String?
  nextAction     String?
  taskId         String
  organisationId String
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organisationId])
}

model PromiseToPay {
  id             String       @id @default(uuid())
  promisedAmount Decimal      @db.Decimal(14, 2)
  promisedDate   DateTime
  status         String       @default("PROMISED")
  notes          String?
  recordedBy     String?
  organisationId String
  customerId     String
  invoiceId      String
  taskId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customer       Customer     @relation(fields: [customerId], references: [id])
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  task           Task?        @relation(fields: [taskId], references: [id])

  @@index([organisationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([promisedDate])
  @@index([status])
}

model Dispute {
  id             String       @id @default(uuid())
  disputeNumber  String?
  reason         String
  description    String
  disputedAmount Decimal?     @db.Decimal(14, 2)
  status         String       @default("OPEN")
  priority       String       @default("MEDIUM")
  resolution     String?
  resolvedAt     DateTime?
  recordedBy     String?
  organisationId String
  customerId     String
  invoiceId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customer       Customer     @relation(fields: [customerId], references: [id])
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@unique([disputeNumber, organisationId])
  @@index([organisationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
}

model Communication {
  id             String       @id @default(uuid())
  channel        String
  direction      String       @default("OUTBOUND")
  subject        String?
  message        String
  outcome        String?
  deliveryStatus String       @default("RECORDED")
  occurredAt     DateTime     @default(now())
  recordedBy     String?
  organisationId String
  customerId     String
  invoiceId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customer       Customer     @relation(fields: [customerId], references: [id])
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([channel])
  @@index([occurredAt])
}

model ReminderTemplate {
  id             String       @id @default(uuid())
  name           String
  triggerStage   String
  channel        String
  subject        String?
  body           String
  isActive       Boolean      @default(true)
  organisationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reminders      Reminder[]
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@unique([name, organisationId])
  @@index([organisationId])
  @@index([triggerStage])
}

model Reminder {
  id                   String                @id @default(uuid())
  scheduledFor         DateTime
  sentAt               DateTime?
  status               String                @default("PENDING")
  channel              String
  subject              String?
  message              String
  dedupeKey            String
  deliveryStatus       String                @default("PENDING")
  createdBy            String?
  organisationId       String
  customerId           String
  invoiceId            String?
  templateId           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attemptCount         Int                   @default(0)
  lastError            String?
  nextAttemptAt        DateTime?
  customerNotification CustomerNotification?
  emailDeliveryAttempt EmailDeliveryAttempt?
  customer             Customer              @relation(fields: [customerId], references: [id])
  invoice              Invoice?              @relation(fields: [invoiceId], references: [id])
  organisation         Organisation          @relation(fields: [organisationId], references: [id])
  template             ReminderTemplate?     @relation(fields: [templateId], references: [id])

  @@unique([organisationId, dedupeKey])
  @@index([organisationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([scheduledFor])
  @@index([status])
}

model SubscriptionPlan {
  id                          String           @id @default(uuid())
  name                        String
  code                        String           @unique
  description                 String?
  monthlyPrice                Decimal?         @db.Decimal(14, 2)
  yearlyPrice                 Decimal?         @db.Decimal(14, 2)
  currency                    String           @default("INR")
  maxUsers                    Int?
  maxCustomers                Int?
  maxInvoicesPerMonth         Int?
  isActive                    Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  proposedMonthlyPrice        Decimal?         @db.Decimal(14, 2)
  proposedYearlyPrice         Decimal?         @db.Decimal(14, 2)
  pricingStatus               String           @default("PENDING_APPROVAL")
  pricingApprovedAt           DateTime?
  pricingApprovedBy           String?
  proposedMaxUsers            Int?
  proposedMaxCustomers        Int?
  proposedMaxInvoicesPerMonth Int?
  limitsStatus                String           @default("PENDING_APPROVAL")
  limitsApprovedAt            DateTime?
  limitsApprovedBy            String?
  pricingProposalStatus       String           @default("PENDING_APPROVAL")
  limitsProposalStatus        String           @default("PENDING_APPROVAL")
  billingPayments             BillingPayment[]
  subscriptions               Subscription[]

  @@index([isActive])
}

model Subscription {
  id             String           @id @default(uuid())
  organisationId String
  planId         String
  status         String           @default("ACTIVE")
  billingCycle   String           @default("MONTHLY")
  startsAt       DateTime         @default(now())
  endsAt         DateTime?
  trialEndsAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  billingAmount  Decimal?         @db.Decimal(14, 2)
  currency       String           @default("INR")
  payment        BillingPayment?
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([organisationId])
  @@index([planId])
  @@index([status])
  @@index([endsAt])
}

model BillingPayment {
  id                String                 @id @default(uuid())
  organisationId    String
  customerId        String?
  planId            String
  subscriptionId    String?                @unique
  billingCycle      String
  amount            Decimal                @db.Decimal(14, 2)
  currency          String                 @default("INR")
  status            String                 @default("CREATING")
  idempotencyKey    String
  razorpayOrderId   String?                @unique
  razorpayPaymentId String?                @unique
  effectiveAt       DateTime
  periodEndsAt      DateTime
  paidAt            DateTime?
  createdBy         String?
  errorCode         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  invoice           BillingInvoice?
  receipt           BillingPaymentReceipt?
  emailDeliveryAttempts EmailDeliveryAttempt[]
  customer          Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organisation      Organisation           @relation(fields: [organisationId], references: [id])
  plan              SubscriptionPlan       @relation(fields: [planId], references: [id])
  subscription      Subscription?          @relation(fields: [subscriptionId], references: [id])
  webhookEvents     RazorpayWebhookEvent[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, status, createdAt])
  @@index([effectiveAt])
  @@index([customerId])
}

model BillingInvoice {
  id             String         @id @default(uuid())
  organisationId String
  paymentId      String         @unique
  invoiceNumber  String
  planName       String
  billingCycle   String
  amount         Decimal        @db.Decimal(14, 2)
  currency       String         @default("INR")
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime       @default(now())
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  payment        BillingPayment @relation(fields: [paymentId], references: [id])

  @@unique([organisationId, invoiceNumber])
  @@index([organisationId, createdAt])
}

model BillingPaymentReceipt {
  id              String         @id @default(uuid())
  organisationId  String
  paymentId       String         @unique
  receiptNumber   String
  pdfBytes        Bytes
  pdfSha256       String
  createdAt       DateTime       @default(now())
  organisation    Organisation   @relation(fields: [organisationId], references: [id])
  payment         BillingPayment @relation(fields: [paymentId], references: [id])

  @@unique([organisationId, receiptNumber])
  @@index([organisationId, createdAt])
}

model RazorpayWebhookEvent {
  id               String          @id @default(uuid())
  organisationId   String?
  billingPaymentId String?
  providerEventId  String          @unique
  eventType        String
  status           String          @default("RECEIVED")
  receivedAt       DateTime        @default(now())
  processedAt      DateTime?
  errorCode        String?
  billingPayment   BillingPayment? @relation(fields: [billingPaymentId], references: [id])
  organisation     Organisation?   @relation(fields: [organisationId], references: [id])

  @@index([status, receivedAt])
  @@index([billingPaymentId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organisationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
}

model CustomerSubscriptionPlan {
  id                      String                        @id @default(uuid())
  organisationId          String
  code                    String
  name                    String
  description             String?
  proposedMonthlyPrice    Decimal?                      @db.Decimal(14, 2)
  proposedYearlyPrice     Decimal?                      @db.Decimal(14, 2)
  monthlyPrice            Decimal?                      @db.Decimal(14, 2)
  yearlyPrice             Decimal?                      @db.Decimal(14, 2)
  currency                String                        @default("INR")
  pricingStatus           String                        @default("PENDING_APPROVAL")
  pricingProposalStatus   String                        @default("PENDING_APPROVAL")
  pricingApprovedAt       DateTime?
  pricingApprovedBy       String?
  proposedTaxTerms        String?
  taxTerms                String?
  taxTermsStatus          String                        @default("PENDING_APPROVAL")
  taxProposalStatus       String                        @default("PENDING_APPROVAL")
  taxApprovedAt           DateTime?
  taxApprovedBy           String?
  isActive                Boolean                       @default(false)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  proposedQuarterlyPrice  Decimal?                      @db.Decimal(14, 2)
  proposedHalfYearlyPrice Decimal?                      @db.Decimal(14, 2)
  quarterlyPrice          Decimal?                      @db.Decimal(14, 2)
  halfYearlyPrice         Decimal?                      @db.Decimal(14, 2)
  features                String[]                      @default([])
  usageLimits             Json                          @default("{}")
  eligibleCustomerTypes   String[]                      @default([])
  subscriptions           CustomerSubscription[]
  payments                CustomerSubscriptionPayment[]
  organisation            Organisation                  @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, code])
  @@index([organisationId, isActive])
}

model CustomerSubscription {
  id                     String                       @id @default(uuid())
  organisationId         String
  customerId             String
  planId                 String
  replacesSubscriptionId String?
  status                 String                       @default("PENDING")
  billingCycle           String
  startsAt               DateTime
  renewalAt              DateTime
  endsAt                 DateTime
  cancelAtPeriodEnd      Boolean                      @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  customer               Customer                     @relation(fields: [customerId], references: [id])
  organisation           Organisation                 @relation(fields: [organisationId], references: [id])
  plan                   CustomerSubscriptionPlan     @relation(fields: [planId], references: [id])
  replaces               CustomerSubscription?        @relation("CustomerSubscriptionReplacement", fields: [replacesSubscriptionId], references: [id])
  replacedBy             CustomerSubscription[]       @relation("CustomerSubscriptionReplacement")
  payment                CustomerSubscriptionPayment?

  @@index([organisationId, customerId, status], map: "CustomerSubscription_org_customer_status_idx")
  @@index([planId])
  @@index([startsAt, endsAt])
}

model CustomerSubscriptionPayment {
  id                String                             @id @default(uuid())
  organisationId    String
  customerId        String
  planId            String
  subscriptionId    String                             @unique
  planName          String
  billingCycle      String
  amount            Decimal                            @db.Decimal(14, 2)
  currency          String                             @default("INR")
  taxTerms          String
  status            String                             @default("CREATING")
  idempotencyKey    String
  razorpayOrderId   String?                            @unique
  razorpayPaymentId String?                            @unique
  periodStart       DateTime
  periodEnd         DateTime
  paidAt            DateTime?
  errorCode         String?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  paymentMethod     String?
  invoice           CustomerSubscriptionInvoice?
  customer          Customer                           @relation(fields: [customerId], references: [id])
  organisation      Organisation                       @relation(fields: [organisationId], references: [id])
  plan              CustomerSubscriptionPlan           @relation(fields: [planId], references: [id])
  subscription      CustomerSubscription               @relation(fields: [subscriptionId], references: [id])
  receipt           CustomerSubscriptionReceipt?
  webhookEvents     CustomerSubscriptionWebhookEvent[]

  @@unique([organisationId, customerId, idempotencyKey], map: "CustomerSubscriptionPayment_org_customer_idem_key")
  @@index([organisationId, customerId, status, createdAt], map: "CustomerSubscriptionPayment_org_customer_status_idx")
  @@index([periodStart, periodEnd])
}

model CustomerSubscriptionInvoice {
  id             String                      @id @default(uuid())
  organisationId String
  customerId     String
  paymentId      String                      @unique
  invoiceNumber  String
  planName       String
  billingCycle   String
  amount         Decimal                     @db.Decimal(14, 2)
  currency       String                      @default("INR")
  taxTerms       String
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime                    @default(now())
  customer       Customer                    @relation(fields: [customerId], references: [id])
  organisation   Organisation                @relation(fields: [organisationId], references: [id])
  payment        CustomerSubscriptionPayment @relation(fields: [paymentId], references: [id])

  @@unique([organisationId, invoiceNumber], map: "CustomerSubscriptionInvoice_org_invoice_key")
  @@index([organisationId, customerId, createdAt], map: "CustomerSubscriptionInvoice_org_customer_created_idx")
}

model CustomerSubscriptionReceipt {
  id                    String                      @id @default(uuid())
  organisationId        String
  customerId            String
  paymentId             String                      @unique
  receiptNumber         String
  transactionId         String?                     @unique
  customerName          String?
  customerEmail         String?
  paymentMethod         String?
  verificationTokenHash String?                     @unique
  pdfBytes              Bytes?
  pdfSha256             String?
  amount                Decimal                     @db.Decimal(14, 2)
  currency              String                      @default("INR")
  paidAt                DateTime
  createdAt             DateTime                    @default(now())
  customer              Customer                    @relation(fields: [customerId], references: [id])
  organisation          Organisation                @relation(fields: [organisationId], references: [id])
  payment               CustomerSubscriptionPayment @relation(fields: [paymentId], references: [id])
  emailDeliveryAttempts EmailDeliveryAttempt[]

  @@unique([organisationId, receiptNumber], map: "CustomerSubscriptionReceipt_org_receipt_key")
  @@index([organisationId, customerId, createdAt], map: "CustomerSubscriptionReceipt_org_customer_created_idx")
}

model CustomerSubscriptionWebhookEvent {
  id              String                       @id @default(uuid())
  organisationId  String?
  customerId      String?
  paymentId       String?
  providerEventId String                       @unique
  eventType       String
  status          String                       @default("RECEIVED")
  receivedAt      DateTime                     @default(now())
  processedAt     DateTime?
  errorCode       String?
  customer        Customer?                    @relation(fields: [customerId], references: [id])
  organisation    Organisation?                @relation(fields: [organisationId], references: [id])
  payment         CustomerSubscriptionPayment? @relation(fields: [paymentId], references: [id])

  @@index([status, receivedAt])
  @@index([paymentId])
}

model CustomerAssistantMessage {
  id             String       @id @default(uuid())
  organisationId String
  customerId     String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, customerId, createdAt], map: "CustomerAssistantMessage_organisationId_customerId_createdAt_id")
}

model CreditAdjustment {
  id               String       @id @default(uuid())
  adjustmentNumber String
  amount           Decimal      @db.Decimal(14, 2)
  reason           String
  notes            String?
  status           String       @default("PENDING")
  createdBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  invoiceId        String
  organisationId   String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])
  organisation     Organisation @relation(fields: [organisationId], references: [id])

  @@unique([adjustmentNumber, organisationId])
  @@index([organisationId])
  @@index([invoiceId])
  @@index([status])
}

model CustomerPortalAccount {
  id                          String                 @id @default(uuid())
  customerId                  String                 @unique
  email                       String                 @unique
  fullName                    String
  passwordHash                String
  emailVerifiedAt             DateTime?
  verificationOtpSentAt       DateTime?
  passwordResetTokenHash      String?                @unique
  passwordResetExpiresAt      DateTime?
  passwordResetSentAt         DateTime?
  sessionVersion              Int                    @default(0)
  timeZone                    String                 @default("Asia/Kolkata")
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  verificationOtpHash         String?
  verificationOtpExpiresAt    DateTime?
  verificationOtpAttemptCount Int                    @default(0)
  notifications               CustomerNotification[]
  customer                    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  emailDeliveryAttempts       EmailDeliveryAttempt[]

  @@index([emailVerifiedAt])
}

model CustomerNotification {
  id             String                 @id @default(uuid())
  customerId     String
  organisationId String
  invoiceId      String?
  receiptId      String?
  reminderId     String?                @unique
  eventType      String
  title          String
  message        String
  readAt         DateTime?
  createdAt      DateTime               @default(now())
  accountId      String?
  account        CustomerPortalAccount? @relation(fields: [accountId], references: [id])
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice        Invoice?               @relation(fields: [invoiceId], references: [id])
  organisation   Organisation           @relation(fields: [organisationId], references: [id])
  receipt        Receipt?               @relation(fields: [receiptId], references: [id])
  reminder       Reminder?              @relation(fields: [reminderId], references: [id])

  @@index([customerId, organisationId, createdAt])
  @@index([customerId, readAt, createdAt])
}

model AdminNotificationRead {
  id             String       @id @default(uuid())
  organisationId String
  userId         String
  sourceKey      String
  readAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId, sourceKey])
  @@index([organisationId, userId, readAt])
}

model EmailDeliveryAttempt {
  id                            String                       @id @default(uuid())
  customerAccountId             String?
  customerId                    String?
  invoiceId                     String?
  receiptId                     String?
  reminderId                    String?                      @unique(map: "EmailDeliveryAttempt_reminderId_key")
  customerSubscriptionReceiptId String?
  billingPaymentId              String?                      @unique
  purpose                       String
  recipient                     String
  status                        String
  attemptCount                  Int                          @default(0)
  providerMessageId             String?
  errorCode                     String?
  errorMessage                  String?
  attemptedAt                   DateTime?
  acceptedAt                    DateTime?
  createdAt                     DateTime                     @default(now())
  customerAccount               CustomerPortalAccount?       @relation(fields: [customerAccountId], references: [id])
  customer                      Customer?                    @relation(fields: [customerId], references: [id])
  invoice                       Invoice?                     @relation(fields: [invoiceId], references: [id])
  receipt                       Receipt?                     @relation(fields: [receiptId], references: [id])
  reminder                      Reminder?                    @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  customerSubscriptionReceipt   CustomerSubscriptionReceipt? @relation(fields: [customerSubscriptionReceiptId], references: [id])
  billingPayment                BillingPayment?              @relation(fields: [billingPaymentId], references: [id], onDelete: SetNull)

  @@unique([customerSubscriptionReceiptId, purpose], map: "EmailAttempt_subReceipt_purpose_key")
  @@index([customerAccountId, purpose, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}
